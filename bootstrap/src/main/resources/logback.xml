<configuration>
    <!-- Log lines carry only technical identifiers and event types, never confidential data (constitution III). -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="Exposed" level="WARN"/>
    <!-- Its TRACE/DEBUG output repeats exception messages, which may contain confidential data: never lower it. -->
    <logger name="io.ktor.server.plugins.statuspages" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
